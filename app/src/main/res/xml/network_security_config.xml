<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit rather than left to the platform default: Lazlo's own network
  traffic (BYOK API calls, in-app browsing — this governs WebView too,
  not just this app's own HTTP stack) never falls back to plaintext, and
  only certificates that shipped with the OS are trusted roots.

  That second point matters specifically for this app: the traffic
  inspector mints its own local MITM CA to decrypt-and-reinspect other
  apps' connections. That CA is deliberately never added as a trust
  anchor here, so Lazlo's own outbound connections can never be
  intercepted by its own inspector, or by anything else with a
  user/admin-installed certificate on the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
