<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI API calls (BYOK) and browsing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the local inspector's VpnService/proxy alive while active. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- No location, contacts, storage-wide, or other broad permissions. -->

    <application
        android:name=".LazloApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Lazlo"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lazlo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Local-loopback traffic inspector. android:permission binds it to
          the OS's own VPN consent dialog; this service never starts
          without the user granting that prompt, and it only ever routes
          to localhost (see proxy/MitmVpnService.kt).
        -->
        <service
            android:name=".proxy.MitmVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local-traffic-inspector" />
        </service>

    </application>

</manifest>
